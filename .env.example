# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Real-Time Auth & PostgreSQL Database)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Shared Class Admin Account (1 Akun Admin Bersama XII PPLG 1)
NEXT_PUBLIC_ADMIN_SHARED_EMAIL="admin@xiipplg1.sch.id"
NEXT_PUBLIC_ADMIN_SHARED_PASSWORD="PPLG1-ADMIN"
